<?xml version="1.0" encoding="utf-8"?>
<!--
  This solution intentionally restores zero third-party NuGet packages.
  The build environment has no outbound network access to nuget.org (see
  docs/gap-log.md and Tranche 0 environment disclosure), so the default
  nuget.org source is removed here to avoid restore trying to reach it.
  Every capability normally pulled from NuGet (Serilog, Polly,
  Microsoft.Data.Sqlite, Skender.Stock.Indicators, xunit, the Zerodha SDK)
  is hand-rolled instead, using only the .NET 8 SDK and the
  Microsoft.AspNetCore.App shared framework (FrameworkReference), both of
  which are already installed locally and require no network access.
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
